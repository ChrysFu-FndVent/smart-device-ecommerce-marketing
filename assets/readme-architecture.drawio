        <mxCell id="title" value="跨品类电商数据营销｜配置、分析与物料溯源" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=30;fontStyle=1;fontFamily=PingFang SC;align=left;verticalAlign=middle;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1120" height="36" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="智能手环只是验证案例；品类词典、分析维度、规格来源和风险规则都通过 category_config 切换。" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=14;fontFamily=PingFang SC;align=left;verticalAlign=middle;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1120" height="28" as="geometry"/></mxCell>
        <mxCell id="categories" value="&lt;b&gt;适用品类&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;智能穿戴 · 智能家居&lt;br&gt;消费电子 · 家电&lt;br&gt;美妆个护 · 户外用品&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.2;fontColor=#0F172A;fontSize=17;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;arcSize=12;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="145" width="175" height="125" as="geometry"/></mxCell>
